<section class="coming-soon" id="coming-soon">
  <div class="coming-soon-inner reveal">
    <span class="eyebrow eyebrow-light">Online ordering soon</span>
    <h2 class="display section-h2 section-h2-light">
      {{ section.settings.heading | default: 'Online ordering is on the way.' }}
    </h2>
    <p class="coming-soon-body">
      {{ section.settings.body | default: 'We are setting up online ordering and shipping for select cakes and pastries. Drop your email below and we will let you know the moment it goes live - no spam, no extra newsletters, just one note when ordering opens.' }}
    </p>

    <form action="/contact#contact_form" method="post" id="contact_form" accept-charset="UTF-8" class="coming-soon-form">
      <input type="hidden" name="form_type" value="contact">
      <input type="hidden" name="utf8" value="&#x2713;">
      <input type="hidden" name="contact[subject]" value="Notify me when online ordering opens">
      <label class="visually-hidden" for="contact_email">Email</label>
      <input type="email" name="contact[email]" id="contact_email" required placeholder="you@email.com" autocomplete="email">
      <button type="submit" class="btn btn-on-dark">Notify me</button>
    </form>

    <p class="coming-soon-foot">
      In the meantime &mdash; come visit. Pastries are best in person anyway.
    </p>
  </div>

  <div class="coming-soon-bg" aria-hidden="true">
    <img src="{{ 'photo_10.webp' | asset_url }}" alt="">
  </div>
</section>

{% schema %}
{
  "name": "Coming Soon",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "Online ordering is on the way."},
    {"type": "textarea", "id": "body", "label": "Body copy"}
  ],
  "presets": [{"name": "Coming Soon"}]
}
{% endschema %}
