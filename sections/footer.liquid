{%- assign cafe_name = settings.cafe_name | default: 'BakerLand Cafe' -%}
{%- assign cafe_phone = settings.cafe_phone | default: '(346) 391-5051' -%}
{%- assign cafe_address = settings.cafe_address | default: '14021 Southwest Fwy, Suite 409A, Sugar Land, TX 77478' -%}
{%- assign cafe_hours = settings.cafe_hours | default: 'Open daily, 6 AM – 12 AM' -%}
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 40 40" width="36" height="36" xmlns="http://www.w3.org/2000/svg">
          <circle cx="20" cy="20" r="18" fill="#FBF4E6"/>
          <path d="M11 22 Q15 13 20 22 Q25 13 29 22 L29 26 Q20 30 11 26 Z" fill="#8C4A2F"/>
        </svg>
      </span>
      <span class="footer-brand-text">
        <span class="footer-brand-name">BakerLand</span>
        <span class="footer-brand-sub">Cafe &middot; Sugar Land, TX</span>
      </span>
    </div>
    <div class="footer-meta">
      <p>{{ cafe_address }}</p>
      <p><a href="tel:{{ cafe_phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', '' }}">{{ cafe_phone }}</a> &middot; {{ cafe_hours }}</p>
    </div>
    <div class="footer-fine">
      &copy; {{ 'now' | date: '%Y' }} {{ cafe_name }}. Made fresh.
    </div>
  </div>
</footer>

<a href="tel:{{ cafe_phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', '' }}" class="mobile-cta">
  <span aria-hidden="true">&#9742;</span> Call {{ cafe_phone }}
</a>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
