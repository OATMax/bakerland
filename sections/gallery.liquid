<section class="gallery" id="gallery">
  <div class="gallery-head reveal">
    <span class="eyebrow">From the case</span>
    <h2 class="display section-h2">Baked this morning. <em class="serif-italic">Probably gone by tonight.</em></h2>
    <p class="gallery-sub">A rotating pastry case alongside a full menu for breakfast, lunch, and dinner. Walk in to see whats fresh today.</p>
  </div>
  <div class="gallery-grid">
    {%- assign tiles = 'photo_03,photo_07,photo_02,photo_01,photo_05,photo_10,photo_08,photo_12' | split: ',' -%}
    {%- for tile in tiles -%}
      <button type="button" class="gallery-tile reveal reveal-d-{% cycle '1','2','3','4' %}" data-lightbox="{{ tile | append: '.webp' | asset_url }}" aria-label="View this BakerLand photo larger">
        <img src="{{ tile | append: '.webp' | asset_url }}" alt="A photograph from BakerLand in Sugar Land, Texas" loading="lazy">
      </button>
    {%- endfor -%}
  </div>
</section>

<div class="lightbox" id="lightbox" hidden role="dialog" aria-modal="true" aria-label="Photo viewer">
  <button type="button" class="lightbox-close" aria-label="Close photo viewer">&times;</button>
  <img class="lightbox-img" src="" alt="A larger view of a BakerLand photo">
</div>

{% schema %}
{
  "name": "Gallery",
  "settings": [],
  "presets": [{"name": "Gallery"}]
}
{% endschema %}
