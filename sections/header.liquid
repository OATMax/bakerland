{%- assign cafe_name = settings.cafe_name | default: 'BakerLand Cafe' -%}
{%- assign cafe_phone = settings.cafe_phone | default: '(346) 391-5051' -%}
<header class="site-header" data-stick>
  <div class="site-header-inner">
    <a href="/" class="site-brand" aria-label="{{ cafe_name }}">
      <img class="site-logo" src="{{ 'logo.svg' | asset_url }}" alt="{{ cafe_name }}" width="788" height="396">
    </a>
    <nav class="site-nav" aria-label="Primary">
      <a href="#about">About</a>
      <a href="#gallery">Pastries</a>
      <a href="#visit">Visit</a>
      <a href="#coming-soon">Online soon</a>
    </nav>
    <a href="tel:{{ cafe_phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', '' }}" class="btn btn-cta">
      <span class="btn-icon" aria-hidden="true">&#9742;</span>
      <span>{{ cafe_phone }}</span>
    </a>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
