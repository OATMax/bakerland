<section class="visit" id="visit">
  <div class="visit-inner">
    <div class="visit-text reveal">
      <span class="eyebrow">Visit Us</span>
      <h2 class="display section-h2">Stop by anytime. <em class="serif-italic">We are open late.</em></h2>
      <p>Find us in the Sugar Land plaza off the Southwest Freeway. Plenty of parking, terrace seating, and a counter full of fresh pastries from 6 AM to midnight, every day of the week.</p>

      <div class="visit-rows">
        <a class="visit-row visit-row-phone" href="tel:{{ settings.cafe_phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', '' }}">
          <span class="visit-icon" aria-hidden="true">&#9742;</span>
          <span class="visit-row-text">
            <span class="visit-row-label">Call us</span>
            <span class="visit-row-value display">{{ settings.cafe_phone }}</span>
          </span>
        </a>
        <div class="visit-row">
          <span class="visit-icon" aria-hidden="true">&#9873;</span>
          <span class="visit-row-text">
            <span class="visit-row-label">Visit</span>
            <span class="visit-row-value">{{ settings.cafe_address }}</span>
          </span>
        </div>
        <div class="visit-row">
          <span class="visit-icon" aria-hidden="true">&#9201;</span>
          <span class="visit-row-text">
            <span class="visit-row-label">Hours</span>
            <span class="visit-row-value">{{ settings.cafe_hours }}</span>
          </span>
        </div>
      </div>

      <a href="{{ settings.cafe_map_url }}" target="_blank" rel="noopener noreferrer" class="btn btn-primary visit-cta">Get directions <span aria-hidden="true">&rarr;</span></a>
    </div>

    <div class="visit-map reveal reveal-r">
      <iframe
        title="Map to BakerLand Cafe in Sugar Land, TX"
        src="https://www.google.com/maps?q={{ settings.cafe_address | url_encode }}&output=embed"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Visit",
  "settings": [],
  "presets": [{"name": "Visit"}]
}
{% endschema %}
